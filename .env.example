# ============================================================
# Neon Poker — Environment Template
# ============================================================
# Copy to .env and fill in. Never commit the real .env.
# All keys here belong to a SEPARATE, project-only account.
# Do not reuse any production credentials.
# ============================================================

# ---- Database (Supabase or Neon) ----------------------------
# Use a project-only Postgres instance. Pooled URL recommended.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/neon_poker

# ---- Server ------------------------------------------------
SERVER_PORT=4000
SERVER_PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated origins allowed via CORS / Socket.IO
ALLOWED_ORIGINS=http://localhost:3000

# Random 64+ char hex. Used to sign session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-real-secret

# ---- Admin -------------------------------------------------
# A bootstrap admin will be created on first start if none exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me-with-a-strong-password

# ---- Game tuning -------------------------------------------
TURN_TIMER_MS=25000
RECONNECT_GRACE_MS=30000
MIN_BUY_IN_MULTIPLIER=20   # buy_in >= big_blind * this

# ---- Telegram notifications (optional) ---------------------
# When both are set, the server pings the chat on every new player
# signup with a deep link to the admin dashboard.
#  - Get a bot token from @BotFather
#  - Get the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
#    after the bot has been added to your group / DM'd by you.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Base URL of the deployed admin dashboard (used in the link). Falls
# back to the first non-localhost entry in ALLOWED_ORIGINS if unset.
# ADMIN_URL=https://dupster-poker-web.vercel.app

# ---- Web (Next.js) -----------------------------------------
# Set in apps/web/.env.local as well, prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
